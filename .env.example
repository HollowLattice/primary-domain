# Hollow Lattice — Environment Variables
# Copy this to .env.local for local development
# Add these same variables in Vercel Dashboard → Settings → Environment Variables

# Email service (uncomment when ready)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Database (uncomment when ready)
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_KEY=eyJxxxxxxx

# Add any API keys for your apps here
# OPENAI_API_KEY=sk-xxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
